# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Brevo Email Configuration
BREVO_API_KEY=your_brevo_api_key_here

# LLM Service Configuration (for AI Chat)
# Supported providers: openai, anthropic, google, deepseek, ollama
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
# LLM_API_URL=https://api.openai.com/v1  # Optional, for custom endpoints

# NocoBase Configuration (for CRM data access)
NOCO_BASE_URL=http://your-nocobase-instance.com
NOCO_TOKEN=your_nocobase_token_here

# Site Configuration
SITE_URL=https://www.sitesynth.com
